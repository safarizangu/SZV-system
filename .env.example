# ============================================================
# Safari Zangu Ventures — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. It contains real credentials.
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_ENV=production
APP_URL=https://safarizanguven.com
ADMIN_EMAIL=admin@safarizanguven.com

# ── Database (Hostinger production) ──────────────────────────
DB_HOST=localhost
DB_USER=u662187129_admin
DB_PASS=YOUR_HOSTINGER_DB_PASSWORD_HERE
DB_NAME=u662187129_safari_zangu

# ── SMTP (Hostinger mail) ─────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USERNAME=admin@safarizanguven.com
SMTP_PASSWORD=YOUR_SMTP_PASSWORD_HERE

# ── PayPal ────────────────────────────────────────────────────
# Change PAYPAL_MODE to 'live' and add live client ID before launch
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=YOUR_PAYPAL_LIVE_CLIENT_ID_HERE

# ── Bank details (shown in quotation emails) ──────────────────
BANK_NAME=ABSA Bank Tanzania
BANK_ACCOUNT_NAME=Safari Zangu Ventures Ltd
BANK_ACCOUNT_NO=YOUR_REAL_ACCOUNT_NUMBER_HERE
BANK_SWIFT=YOUR_SWIFT_CODE_HERE
WISE_EMAIL=payments@safarizanguven.com

# ── Google Analytics 4 ───────────────────────────────────────
# Get your Measurement ID from Google Analytics → Admin → Data Streams
GA4_ID=G-YOURCODE

# ── Cron secret ──────────────────────────────────────────────
CRON_SECRET=change-this-to-random-string
