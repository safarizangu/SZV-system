# Safari Zangu Ventures — .htaccess

<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

ServerSignature Off

<Files "php/config.php">
  Order allow,deny
  Deny from all
</Files>
<Files "*.md">
  Order allow,deny
  Deny from all
</Files>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType application/javascript  "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always serve index.php first
  DirectoryIndex index.php index.html

  # index.html → index.php
  RewriteCond %{THE_REQUEST} \s/.*index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1index.php [R=301,L]

  # about.html → about.php
  RewriteCond %{THE_REQUEST} \s/.*about\.html[\s?] [NC]
  RewriteRule ^(.*/)?about\.html$ /$1about.php [R=301,L]

  # Force HTTPS on production ONLY — never redirect on localhost
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  RewriteCond %{HTTP_HOST} !^::1 [NC]
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

Options -Indexes

# Block dangerous/development files
<FilesMatch "\.(py|sh|env|log|sql|txt|bak|swp)$">
  Order allow,deny
  Deny from all
</FilesMatch>
<Files "n.php">
  Order allow,deny
  Deny from all
</Files>
<Files "app.php">
  Order allow,deny
  Deny from all
</Files>
<Files "home.php">
  Order allow,deny
  Deny from all
</Files>

# Content Security Policy
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.paypal.com https://www.googletagmanager.com https://www.google-analytics.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.paypal.com https://www.google-analytics.com https://analytics.google.com; frame-src https://www.paypal.com;"
</IfModule>

# Custom error pages
# Error pages — update path if deploying to subfolder
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php
