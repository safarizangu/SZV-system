# ════════════════════════════════════════════════════════════
# Safari Zangu Ventures — .htaccess
# Root: document root for Apache
# Public pages now live in public/ — rewrite rules map them
# ════════════════════════════════════════════════════════════

Options -Indexes
ServerSignature Off

# ── Security headers ─────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  # HSTS — uncomment on Hostinger after HTTPS confirmed:
  # Header always set Strict-Transport-Security "max-age=2592000; includeSubDomains"
</IfModule>

# ── Block sensitive directories and file types ────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  # No RewriteBase: left to Apache's default per-directory inference, which
  # correctly resolves to '/' when this .htaccess sits at the true docroot
  # (production, files in public_html/ root) AND to '/safari-zangu/' when it
  # sits in a plain subfolder of a shared docroot (local dev on this
  # machine — no Apache Alias is configured here, confirmed live). A
  # hardcoded `RewriteBase /` only produces correct rewrite targets in the
  # first case; in the second it turns `public/$1` into `/public/$1`
  # (true docroot), 404ing every public page except the directory index.

  # Block hidden files except .well-known (for SSL certs)
  RewriteRule ^\.(?!well-known) - [F,L]

  # Block stray .json/.txt/.log files anywhere in the tree — added after a
  # prior scan tool's leftover report files (folder_tree.txt,
  # security_report.json, etc.) were found live-exposed in the web root.
  # robots.txt is the one legitimate public .txt file and is exempted.
  RewriteCond %{REQUEST_URI} !robots\.txt$
  RewriteRule \.(json|txt|log)$ - [F,L]

  # Block sensitive directories
  # DEVOPS-4: vendor/ was never in this list — vendor/autoload.php and any
  # other non-.json/.txt/.log file inside it was directly web-fetchable
  # (confirmed via curl); only files ending .json/.txt/.log happened to be
  # caught incidentally by the extension rule above.
  # SEC-11: docs/ was never in this list either — docs/*.md was caught
  # incidentally by the .md extension rule below, but every PDF under
  # docs/reports/ (Security_Audit_Report.pdf, Admin_Role_Access_Report.pdf,
  # Database_Architecture.pdf, Booking_Workflow_Map.pdf, etc.) was directly
  # web-fetchable with no auth — confirmed via curl (200, not 403/302).
  # SEC-11: views/ and layouts/ are template partials, never routes —
  # requesting them directly (e.g. /views/book.php, /layouts/admin.php)
  # isn't caught by any controller's own auth check and instead hits a PHP
  # fatal on an undefined variable the real includer would have set. That's
  # not a real access control (it only "works" because display_errors is
  # off) and layouts/admin.php was confirmed to leak a fragment of its
  # rendered HTML before erroring, so block the directories outright.
  RewriteRule ^(app|config|database|storage|sql|tests|cron|vendor|docs|views|layouts)/  - [F,L]

  # Block sensitive directories from web access
  RewriteRule ^sql/      - [F,L]
  RewriteRule ^app/      - [F,L]
  RewriteRule ^config/   - [F,L]
  RewriteRule ^storage/  - [F,L]
  RewriteRule ^database/ - [F,L]
  RewriteRule ^tests/    - [F,L]
  RewriteRule ^vendor/   - [F,L]
  RewriteRule ^cron/     - [F,L]
  RewriteRule ^docs/     - [F,L]
  RewriteRule ^views/    - [F,L]
  RewriteRule ^layouts/  - [F,L]

  # Block api/cron from browser access (cron only, not AJAX)
  RewriteRule ^api/cron/  - [F,L]

  # ── HTTPS redirect (production only) ─────────────────────────
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # ── Route public pages from root URL → public/ directory ─────
  # This lets safarizanguven.com/about.php work even though
  # the file lives in public/about.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/public/
  RewriteCond %{REQUEST_URI} !^/admin/
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteRule ^([a-zA-Z0-9_-]+\.php)$ public/$1 [L,QSA]

  # ── Root index → public/index.php ────────────────────────────
  DirectoryIndex public/index.php index.php

</IfModule>

# ── Block sensitive file types ────────────────────────────────
# DEVOPS-4: composer.lock has no .json/.txt/.log extension so it wasn't
# caught by the rewrite rule above — confirmed fetchable via curl,
# disclosing exact dependency versions (e.g. dompdf 3.1.6).
<FilesMatch "\.(env|env\.example|py|sh|sql|log|bak|swp|gitignore|md)$|^composer\.(json|lock)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Block dev/temp scripts at root
<FilesMatch "^(n\.py|n\.sh|check_cron_status\.sh)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# ── Error pages ───────────────────────────────────────────────
ErrorDocument 404 /public/404.php
ErrorDocument 500 /public/500.php

# ── HTTPS redirect for Hostinger root deployment ─────────────
# (already handled above via RewriteRule)

# ── Caching ───────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType text/css               "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# ── Compression ───────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain
</IfModule>

# ── Content Security Policy ───────────────────────────────────
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.paypal.com https://www.googletagmanager.com https://www.google-analytics.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.paypal.com https://www.google-analytics.com https://analytics.google.com; frame-src https://www.paypal.com https://www.google.com;"
</IfModule>
