# ── Secrets ──────────────────────────────────────────────────
.env
*.env.local

# ── Storage (runtime, not committed) ─────────────────────────
storage/cache/*
storage/logs/*
storage/uploads/*
!storage/cache/.gitkeep
!storage/logs/.gitkeep
!storage/uploads/.gitkeep

# Audit screenshots and pre-session leftover scan artifacts — kept on disk
# (protected by storage/.htaccess) but not worth tracking in git history.
storage/screenshots/
storage/legacy_scan_artifacts/

# ── Dev scripts (never on production) ────────────────────────
n.py
n.sh
check_cron_status.sh
*.pyc
__pycache__/

# ── Vendor / dependencies ─────────────────────────────────────
vendor/
php/PHPMailer/

# ── OS / IDE ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ── Logs ──────────────────────────────────────────────────────
*.log

# ── Temp / build ─────────────────────────────────────────────
*.bak
*.tmp
/public/*.bak
